PORT=3000
NODE_ENV=development
DATABASE_URL=postgresql://user:pass@localhost:5432/whatsapp_agent
JWT_SECRET=change-me-to-a-32-char-minimum-secret
JWT_EXPIRES_IN=7d

# Azure Blob (optional — falls back to local storage)
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_ACCOUNT_ACCESS_KEY=
AZURE_STORAGE_CONTAINER=whatsapp-media

# Local storage fallback
LOCAL_STORAGE_DIR=./storage

# AI Provider: openai | anthropic | ollama | none
AI_PROVIDER=none
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_URL=http://localhost:11434

# WhatsApp
WA_AUTH_DIR=./auth_sessions

# Logging
LOG_LEVEL=info

# CORS
CORS_ORIGIN=*

# Symphony (spec-driven orchestrator)
SYMPHONY_ENABLED=false
SYMPHONY_WORKFLOW_PATH=./WORKFLOW.md
SYMPHONY_GITHUB_OWNER=
SYMPHONY_GITHUB_REPO=
SYMPHONY_GITHUB_TOKEN=
SYMPHONY_GITHUB_LABELS=symphony
SYMPHONY_WORKSPACE_ROOT=/tmp/symphony-whatsapp
SYMPHONY_MAX_AGENTS=3
SYMPHONY_POLL_INTERVAL_MS=30000
SYMPHONY_DASHBOARD_PORT=
